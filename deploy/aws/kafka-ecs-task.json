{
  "family": "helio-production-kafka",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::493155413835:role/helio-production-execution",
  "containerDefinitions": [
    {
      "name": "kafka",
      "image": "apache/kafka:3.9.0",
      "essential": true,
      "command": [
        "sh",
        "-c",
        "IP=$(hostname -i | awk '{print $NF}'); export KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://${IP}:9092; echo advertised=$KAFKA_ADVERTISED_LISTENERS; exec /etc/kafka/docker/run"
      ],
      "portMappings": [
        {
          "name": "kafka",
          "containerPort": 9092,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "KAFKA_NODE_ID", "value": "1" },
        { "name": "KAFKA_PROCESS_ROLES", "value": "broker,controller" },
        { "name": "CLUSTER_ID", "value": "MkU3OEVBNTcwNTJENDM2Qk" },
        { "name": "KAFKA_LISTENERS", "value": "PLAINTEXT://:9092,CONTROLLER://:9093" },
        { "name": "KAFKA_ADVERTISED_LISTENERS", "value": "PLAINTEXT://kafka.helio.internal:9092" },
        { "name": "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP", "value": "CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT" },
        { "name": "KAFKA_CONTROLLER_QUORUM_VOTERS", "value": "1@127.0.0.1:9093" },
        { "name": "KAFKA_CONTROLLER_LISTENER_NAMES", "value": "CONTROLLER" },
        { "name": "KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR", "value": "1" },
        { "name": "KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR", "value": "1" },
        { "name": "KAFKA_TRANSACTION_STATE_LOG_MIN_ISR", "value": "1" },
        { "name": "KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS", "value": "0" },
        { "name": "KAFKA_NUM_PARTITIONS", "value": "3" },
        { "name": "KAFKA_HEAP_OPTS", "value": "-Xms256M -Xmx512M" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/helio-production/kafka",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
